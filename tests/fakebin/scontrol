#!/bin/sh
# Fake scontrol used by the collector test-suite.
FIX="$(dirname "$0")/../fixtures"
[ -n "$SLURM_TEST_COUNTER" ] && echo "scontrol $*" >> "$SLURM_TEST_COUNTER"
case "$1 $2" in
  "ping ")            cat "$FIX/scontrol_ping.txt" ;;
  "show config")      cat "$FIX/scontrol_show_config.txt" ;;
  "show partition")   cat "$FIX/scontrol_show_partition.txt" ;;
  "show reservation") cat "$FIX/scontrol_show_reservation.txt" ;;
  "show licenses")    cat "$FIX/scontrol_show_licenses.txt" ;;
  "show node")
      # "show node NAME" returns just that node, like the real command.
      if [ -n "$3" ] && [ "$3" != "--oneliner" ]; then
          grep -h "^NodeName=$3 " "$FIX/scontrol_show_node.txt" \
               "$FIX/scontrol_show_node_untracked_gres.txt" \
               "$FIX/scontrol_show_node_no_gresused.txt" \
               "$FIX/scontrol_show_node_gpu.txt" 2>/dev/null
      else
          cat "$FIX/scontrol_show_node.txt"
      fi ;;
  *) echo "fake scontrol: unsupported arguments: $*" >&2; exit 1 ;;
esac
