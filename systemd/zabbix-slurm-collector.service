[Unit]
Description=Refresh the Slurm metrics cache read by the Zabbix agent
Documentation=https://github.com/Kevin-NZ/Zabbix-Slurm
After=network.target

[Service]
Type=oneshot
User=zabbix
Group=zabbix
ExecStart=/usr/local/bin/slurm_zabbix.py --refresh --cache-file /var/lib/zabbix-slurm/cache.json

# The cache directory is created on first start if it does not exist.
StateDirectory=zabbix-slurm
StateDirectoryMode=0750

# The collector only reads Slurm state, so it needs no privileges of its own.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/zabbix-slurm

# Never let a hung Slurm command keep the unit running until the next firing.
TimeoutStartSec=50

[Install]
WantedBy=multi-user.target
